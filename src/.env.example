APP_NAME=XBOT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=xbotv2
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PUBLIC_ASSETS_PATH=

TELEGRAM_WEBHOOK_DEDUP_TTL_MINUTES=10

WEATHER_HTTP_TIMEOUT_SECONDS=5
WEATHER_HTTP_RETRIES=2
WEATHER_HTTP_RETRY_SLEEP_MS=200
WEATHER_SETTINGS_CACHE_TTL_MINUTES=10
WEATHER_CACHE_TTL_MINUTES=60
WEATHER_CITY_MIN_LENGTH=2
WEATHER_GEO_SEARCH_LIMIT=5

VIN_API_TIMEOUT_SECONDS=8
VIN_API_RETRIES=2
VIN_API_RETRY_SLEEP_MS=200
VIN_CACHE_TTL_MINUTES=1440
VIN_SETTINGS_CACHE_TTL_MINUTES=10
VIN_LENGTH=17
VIN_PHOTO_CONFIRMATION_TTL_MINUTES=5
VIN_PHOTO_RATE_LIMIT_SECONDS=10

# DeepSeek Vision для распознавания VIN по фото
VIN_VISION_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash
VIN_VISION_TIMEOUT_SECONDS=20
VIN_VISION_RETRIES=2
VIN_VISION_RETRY_SLEEP_MS=300
VIN_VISION_MAX_TOKENS=400
VIN_VISION_MAX_IMAGE_MB=10
VIN_VISION_MIN_CONFIDENCE=0.5

# «Тихо» — отдельный бот психологической поддержки
PSYCHOLOGIST_ENABLED=true
PSYCHOLOGIST_DEEPSEEK_API_KEY=
PSYCHOLOGIST_DEEPSEEK_BASE_URL=https://api.deepseek.com
PSYCHOLOGIST_DEEPSEEK_MODEL=deepseek-flash
PSYCHOLOGIST_TIMEOUT_SECONDS=30
PSYCHOLOGIST_RETRIES=2
PSYCHOLOGIST_RETRY_SLEEP_MS=300
PSYCHOLOGIST_MAX_OUTPUT_TOKENS=700
PSYCHOLOGIST_CONTEXT_MAX_TURNS=12
PSYCHOLOGIST_CONTEXT_TTL_MINUTES=180
PSYCHOLOGIST_SUMMARY_AFTER_MESSAGES=8
PSYCHOLOGIST_MAX_SUMMARY_CHARS=1800

HOSTING=0
